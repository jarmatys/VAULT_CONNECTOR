{
  "name": "vaultconnector",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only access to selected folders of an Obsidian vault from Claude and other AI assistants, hosted or self-hosted.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "SOFTURE_HOST=cloudflare opennextjs-cloudflare build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && softure-check-language --all",
    "test": "vitest run",
    "migrate": "softure migrate",
    "e2e": "playwright test",
    "e2e:workers": "playwright test -c playwright.workers.config.ts",
    "e2e:compose": "playwright test -c playwright.compose.config.ts",
    "prepare": "node -e \"process.exit(process.env.CI?0:1)\" || lefthook install",
    "funnel": "node scripts/funnel-report.ts",
    "measure:tools": "vitest run -c scripts/measure/vitest.config.mts",
    "measure:report": "node scripts/measure/report.ts",
    "index:hit-rate": "node scripts/index-hit-rate.ts",
    "reviewer": "node scripts/reviewer-account.ts",
    "docs:bundle": "node scripts/bundle-docs.ts",
    "worker": "node scripts/worker.ts",
    "grafana:alerts": "softure-observability grafana apply --rules grafana/alert-rules.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@softure-ai/agent-ready": "^0.2.3",
    "@softure-ai/alerts": "^0.2.4",
    "@softure-ai/analytics": "^0.3.6",
    "@softure-ai/auth": "^0.2.24",
    "@softure-ai/backup": "^0.1.3",
    "@softure-ai/billing": "^0.11.4",
    "@softure-ai/connections": "^0.8.0",
    "@softure-ai/core": "^0.2.11",
    "@softure-ai/db": "^0.1.17",
    "@softure-ai/feature-switches": "^0.2.2",
    "@softure-ai/files": "^0.6.1",
    "@softure-ai/jobs": "^0.1.15",
    "@softure-ai/llm": "^0.4.0",
    "@softure-ai/mailing": "^0.3.0",
    "@softure-ai/mcp-access": "^0.7.9",
    "@softure-ai/metering": "^0.4.2",
    "@softure-ai/observability": "^0.8.8",
    "@softure-ai/ops": "^0.2.6",
    "@softure-ai/privacy": "^0.3.0",
    "@softure-ai/security": "^0.2.12",
    "@softure-ai/seo": "^0.2.3",
    "@softure-ai/theme-notion": "^0.35.0",
    "@softure-ai/ui": "^0.3.11",
    "@softure-ai/waitlist": "^0.5.5",
    "ai": "^7.0.173",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.74.0",
    "markdown-it": "^15.0.3",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@eslint/js": "^9.39.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.63.0",
    "@softure-ai/config": "^0.1.7",
    "@softure-ai/skills": "^0.41.1",
    "@softure-ai/testing": "^0.6.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.164.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  }
}
