# VaultConnector's settings. Every value that differs between the hosted instance and a self-hosted one is an
# environment variable; copy this file to `.env.local` for `npm run dev`. Leave a line empty to use its default.

# Postgres 16 with pgvector. Default: postgresql://postgres:postgres@localhost:5432/vaultconnector
DATABASE_URL=
# The public address of the app, used in links and redirects. Default: http://localhost:3000
APP_ORIGIN=

# Mail (password reset). Without RESEND_API_KEY, mail goes to the test outbox when MAIL_OUTBOX_URL is set and is
# refused otherwise, so no mail silently disappears.
RESEND_API_KEY=
# The sender, on a domain verified in Resend. Default: a placeholder on example.com that is never delivered.
MAIL_FROM=
MAIL_REPLY_TO=

# Sign-in with GitHub: the client ID and secret of the GitHub App (or OAuth App) used for sign-in. Without both, the
# GitHub button is hidden. Callback URL to register: <APP_ORIGIN>/api/auth/oidc/github/callback
GH_AUTH_CLIENT_ID=
GH_AUTH_CLIENT_SECRET=

# Rate limits are keyed by the CF-Connecting-IP header Cloudflare sets. Without Cloudflare in front (next dev, a test
# stack), set 1 to count every request under one shared key instead of refusing it. Never in production.
RATE_LIMIT_SHARED_FALLBACK=

# Close registration (true/false) over the stored switch. Existing accounts still sign in.
SOFTURE_SWITCH_AUTH_REGISTRATION_CLOSED=
