# VaultConnector's settings. Every value that differs between the hosted instance and a self-hosted one is an
# environment variable. Self-hosted with Docker Compose: copy this file to `.env` next to docker-compose.yml
# (docs/self-hosting.md). Development: copy it to `.env.local` for `npm run dev`. Leave a line empty to use its default.

# --- Docker Compose only (docker-compose.yml) ---------------------------------------------------------------------
# Required: the passwords of Postgres's superuser, of the migrator and of the app's role (URL-safe, e.g.
# `openssl rand -hex 32`). They are set when the database volume is first created; changing them later needs ALTER ROLE.
POSTGRES_PASSWORD=
SOFTURE_MIGRATOR_PASSWORD=
SOFTURE_APP_PASSWORD=
# Where the app is published on the host: 127.0.0.1:3000 by default, for a reverse proxy on the same machine.
APP_BIND=
APP_PORT=
# The image the stack runs; the default is built from this repository by `docker compose up --build`.
VAULTCONNECTOR_IMAGE=
# The commit GET /api/health/build names; pass it when you build: SOFTURE_BUILD_COMMIT=$(git rev-parse HEAD).
SOFTURE_BUILD_COMMIT=
# The note store's bucket in the bundled SeaweedFS (default vaultconnector-notes) and its key pair, which you choose:
# VAULT_S3_BUCKET, VAULT_S3_ACCESS_KEY_ID and VAULT_S3_SECRET_ACCESS_KEY below. The endpoint is set by the compose file.
# Where the rate limits read a client's address: cloudflare (the CF-Connecting-IP header), forwarded-for (the entry
# TRUSTED_PROXY_HOPS proxies from the right of X-Forwarded-For; the compose default, one proxy) or header:<name> (one
# header your proxy overwrites, e.g. header:x-real-ip). Unset outside compose: cloudflare.
CLIENT_IP_SOURCE=
TRUSTED_PROXY_HOPS=
# ------------------------------------------------------------------------------------------------------------------

# Postgres 16 with pgvector. Default: postgresql://postgres:postgres@localhost:5432/vaultconnector
DATABASE_URL=
# The public address of the app, used in links, robots.txt and the sitemap. Default: http://localhost:3000
APP_ORIGIN=
# The source code link (AGPL-3.0 section 13); point it at your fork. Default: this repository.
SOURCE_CODE_URL=

# Mail (password reset, the waitlist's welcome). Without RESEND_API_KEY, mail goes to the test outbox (the file
# MAIL_OUTBOX, or MAIL_OUTBOX_URL) and is refused without either, so no mail silently disappears.
RESEND_API_KEY=
MAIL_OUTBOX=
# The sender, on a domain verified in Resend. Default: a placeholder on example.invalid that is never delivered.
MAIL_FROM=
# Signs the unsubscribe link of list mail. Without it, list mail is refused; sign-ups still count.
MAILING_UNSUBSCRIBE_SECRET=

# Sign-in with GitHub: the client ID and secret of the GitHub App (or OAuth App) used for sign-in. Without both, the
# GitHub button is hidden. Callback URL to register: <APP_ORIGIN>/api/auth/oidc/github/callback
GH_AUTH_CLIENT_ID=
GH_AUTH_CLIENT_SECRET=

# The vault source: the same GitHub App, installed by each account on the one repository that holds its vault. Its
# numeric App ID, its URL name (github.com/apps/<slug>) and its private key (PEM; newlines may be written as \n).
# Without all three (and the two values above) the source screen says the git source is not configured.
# On the App: permissions Contents read-only and Metadata read-only, nothing else; Setup URL
# <APP_ORIGIN>/panel/source/github/setup; an extra callback URL <APP_ORIGIN>/panel/source/github/callback.
GH_APP_ID=
GH_APP_SLUG=
GH_APP_PRIVATE_KEY=
# The App's webhook secret: a push to a connected repository then syncs at once (webhook URL
# <APP_ORIGIN>/api/webhooks/github, event "Push"). Without it every delivery is refused and the five-minute check
# alone follows the vaults.
GH_WEBHOOK_SECRET=

# The note store: copies of the shared notes, under keys that carry no account id or path. Either an S3-compatible
# bucket (Cloudflare R2: the endpoint https://<account>.eu.r2.cloudflarestorage.com, region auto) or, self-hosted, a
# local directory. VAULT_STORAGE_KEY_SECRET (32 characters or more, e.g. `openssl rand -hex 32`) derives the keys;
# changing it orphans every stored copy. Without a store and the secret, nothing is synced.
VAULT_S3_ENDPOINT=
VAULT_S3_BUCKET=
VAULT_S3_REGION=
VAULT_S3_ACCESS_KEY_ID=
VAULT_S3_SECRET_ACCESS_KEY=
VAULT_STORAGE_DIR=
VAULT_STORAGE_KEY_SECRET=

# Search by meaning: an OpenAI-compatible /embeddings endpoint (a model server next to the app, e.g. Ollama at
# http://ollama:11434/v1, or a hosted API) whose model answers 1024-number vectors (default model bge-m3). The key is
# sent as a bearer token when set. Without EMBEDDINGS_URL the index is keyword-only and search works by words. On
# Cloudflare the Worker's Workers AI binding is used instead (EMBEDDINGS_MODEL then defaults to @cf/baai/bge-m3).
# Changing the model re-indexes every note.
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=

# Plan limits (VC-14): every account's plan caps its copied notes, their storage and its searches a month
# (src/lib/plans.ts). "unlimited" lifts every limit, for a self-hosted instance; anything else (or unset) enforces them.
PLAN_LIMITS=

# An account's own S3-compatible bucket as its vault source (VC-20). VAULT_SOURCE_KEYS seals the bucket keys the
# accounts enter (`npx softure-connections key`, the format `<id>:<base64 of 32 bytes>`; the first key seals, every key
# opens). Without it the panel offers no bucket. VAULT_S3_ALLOW_PRIVATE_ENDPOINTS=1 lets a self-hosted instance read a
# bucket on its own network (MinIO on localhost, http included); never on a shared instance.
VAULT_SOURCE_KEYS=
VAULT_S3_ALLOW_PRIVATE_ENDPOINTS=

# An account's Dropbox folder as its vault source (VC-21): the product's Dropbox app (a scoped app with the
# files.metadata.read and files.content.read permissions only, redirect URI <APP_ORIGIN>/panel/source/dropbox/callback).
# The refresh tokens are sealed with VAULT_SOURCE_KEYS above, so both are needed. Without them the panel offers no
# Dropbox folder.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# A vault of an account's Obsidian Sync subscription as its vault source (VC-22) needs no setting of its own: with
# VAULT_SOURCE_KEYS above set, the panel offers it, and the session and the vault key are sealed with those keys. The
# vault's encryption password is never stored. HEADLESS_SYNC_FAKE_ORIGIN is for the end-to-end tests' loopback fake
# only; never set it anywhere else.

# Payment for the plans (VC-15) through Stripe Checkout, one payment per period: the secret key and the signing secret
# of the webhook endpoint <APP_ORIGIN>/api/billing/webhook (event checkout.session.completed and charge.refunded).
# Only an instance that enforces the plans takes payment; PLAN_LIMITS=unlimited (self-hosted) needs neither.
# STRIPE_API_BASE points Stripe's API elsewhere (the e2e suite's fake); leave it empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=

# Rate limits are keyed by the CF-Connecting-IP header Cloudflare sets. Without Cloudflare in front (next dev, a test
# stack), set 1 to count every request under one shared key instead of refusing it. Never in production.
RATE_LIMIT_SHARED_FALLBACK=

# Close registration (true/false) over the stored switch. Existing accounts still sign in.
SOFTURE_SWITCH_AUTH_REGISTRATION_CLOSED=

# Who runs this instance, named in the privacy policy and the terms (read when the app is built: rebuild after a
# change). The contact is an address, an email or a page.
OPERATOR_NAME=
OPERATOR_CONTACT=
# The accounts that may open /admin/jobs and /admin/alerts (comma-separated; register them first).
ADMIN_EMAILS=
# Where the operator's alerts go: an email (needs mail) and, optionally, a webhook.
ALERTS_MAIL_TO=
ALERTS_WEBHOOK_URL=
# Logs and traces to an OpenTelemetry backend (OTLP over HTTP); nothing leaves without the endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
