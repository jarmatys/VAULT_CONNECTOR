// The Worker of VaultConnector, first written by `softure-deploy init --host=cloudflare` (@softure-ai/deploy 0.7.1);
// the app owns this file. It holds two configurations:
// - the top level is local only: `wrangler dev` for the e2e suite on workerd, with no Cloudflare account and the
//   Hyperdrive binding on a local connection string;
// - `env.production` is what a release deploys (`--env production`, through scripts/deploy/wrangler.sh).
// The repository is public, so it holds no domain and no account resource: scripts/deploy/wrangler.sh fills
// __APP_DOMAIN__ and __HYPERDRIVE_ID__ from the GitHub Environment `production` into a copy it hands to wrangler.
// Secrets never go here either: the release uploads them with the code (`wrangler deploy --secrets-file`), and
// `secrets.required` makes wrangler refuse a deploy that misses one. docs/deployment.md lists every value.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaultconnector",
  // OpenNext's handler inside the request database and the observability wrapper (worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // worker.ts imports @softure-ai/db/request, whose PGlite branch wrangler would bundle; the app installs no PGlite, so
  // both PGlite imports take the stand-in that refuses, the same one withDatabaseBuild gives the Next bundle.
  "alias": {
    "@electric-sql/pglite": "./node_modules/@softure-ai/db/dist/next-config/pglite-unavailable.js",
    "drizzle-orm/pglite": "./node_modules/@softure-ai/db/dist/next-config/pglite-unavailable.js"
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "local", "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/vaultconnector" }],
  "vars": { "SOFTURE_HOST": "cloudflare" },
  "env": {
    "production": {
      // The same Worker name as the top level; without it wrangler would deploy `vaultconnector-production`.
      "name": "vaultconnector",
      // Only the product's own domain serves it: no workers.dev address and no preview URLs.
      "routes": [{ "pattern": "__APP_DOMAIN__", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      // Smart Placement moves the Worker towards the database (Neon, EU region) once it sees traffic.
      "placement": { "mode": "smart" },
      // One jobs tick a minute (worker.ts `scheduled`): the vault sync's steps and its five-minute check.
      "triggers": { "crons": ["* * * * *"] },
      // Postgres through Hyperdrive (SOFTURE/AI docs/07-runtime-providers.md): the Worker reads
      // env.HYPERDRIVE.connectionString, a pooled URL of the app role.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "__HYPERDRIVE_ID__" }],
      // The environment label of the exported logs, which grafana/alert-rules.json matches.
      "vars": {
        "SOFTURE_HOST": "cloudflare",
        "APP_ORIGIN": "https://__APP_DOMAIN__",
        "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment.name=production"
      },
      // Every name here is also a `secret-names` entry and an `env:` line of the deploy step in release.yml.
      "secrets": {
        "required": [
          "RESEND_API_KEY",
          "MAIL_FROM",
          "MAILING_UNSUBSCRIBE_SECRET",
          "GH_AUTH_CLIENT_ID",
          "GH_AUTH_CLIENT_SECRET",
          "GH_APP_ID",
          "GH_APP_SLUG",
          "GH_APP_PRIVATE_KEY",
          "OPERATOR_NAME",
          "OPERATOR_CONTACT",
          "VAULT_S3_ENDPOINT",
          "VAULT_S3_BUCKET",
          "VAULT_S3_ACCESS_KEY_ID",
          "VAULT_S3_SECRET_ACCESS_KEY",
          "VAULT_STORAGE_KEY_SECRET",
          "GH_WEBHOOK_SECRET",
          "VAULT_SOURCE_KEYS",
          "ALERTS_MAIL_TO",
          "ADMIN_EMAILS",
          "OTEL_EXPORTER_OTLP_ENDPOINT",
          "OTEL_EXPORTER_OTLP_HEADERS"
        ]
      }
    }
  }
}
